# Step 1: Start with an official Python image
FROM python:3.10-slim

# Step 2: Set workspace directory
WORKDIR /app

# Step 3: Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Step 4: Copy dashboard code
COPY . .

# Step 5: Expose Streamlit's default web port
EXPOSE 8501

# Step 6: Start Streamlit server
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]